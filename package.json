{
  "name": "cakrawala-math",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive junior-high mathematics learning website (Grades 7–9)",
  "scripts": {
    "start": "docusaurus start --host 0.0.0.0",
    "prestart": "node scripts/design-tokens.mjs",
    "dev": "docusaurus start --host 0.0.0.0",
    "predev": "node scripts/design-tokens.mjs",
    "build": "docusaurus build",
    "prebuild": "node scripts/design-tokens.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/design-tokens.mjs",
    "design:tokens": "node scripts/design-tokens.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.3",
    "webpack": "^5.101.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
